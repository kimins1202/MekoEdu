{
  "expo": {
    "name": "MekoEdu",
    "slug": "MekoEdu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mekosoft-logo.png",
    "scheme": "mekoedu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mekoedu.app",
      "icon": "./assets/images/mekosoft-logo.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.mekoedu.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/mekosoft-logo.png"
    },
    "plugins": [
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "303e1f63-2ddf-4d72-8a5d-ad115ebbb6f9"
      }
    }
  }
}
